from collections.abc import Mapping, Sequence
from typing import Self
from Foundation import NSData, NSIndexSet
from Quartz import CVPixelBufferRef

class VNImageRequestHandler:
    @classmethod
    def alloc(cls) -> Self: ...
    def initWithData_options_(self, data: NSData, options: Mapping[str, object] | None) -> Self | None: ...
    def performRequests_error_(self, requests: Sequence[VNGenerateForegroundInstanceMaskRequest], error: None) -> tuple[bool, object | None]: ...

class VNInstanceMaskObservation:
    def allInstances(self) -> NSIndexSet: ...
    def generateScaledMaskForImageForInstances_fromRequestHandler_error_(self, instances: NSIndexSet, handler: VNImageRequestHandler, error: None) -> tuple[CVPixelBufferRef | None, object | None]: ...

class VNGenerateForegroundInstanceMaskRequest:
    @classmethod
    def alloc(cls) -> Self: ...
    def init(self) -> Self | None: ...
    def results(self) -> Sequence[VNInstanceMaskObservation] | None: ...
