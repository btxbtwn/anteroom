from collections.abc import MutableMapping
from typing import Self

class NSIndexSet: ...

class NSBundle:
    @classmethod
    def mainBundle(cls) -> Self: ...
    def localizedInfoDictionary(self) -> MutableMapping[str, object] | None: ...
    def infoDictionary(self) -> MutableMapping[str, object] | None: ...

class NSData:
    @classmethod
    def dataWithBytes_length_(cls, data: bytes, length: int) -> Self: ...

class NSURL:
    @classmethod
    def URLWithString_(cls, value: str) -> Self | None: ...

class NSURLRequest:
    @classmethod
    def requestWithURL_(cls, url: NSURL) -> Self: ...

def NSStringFromSelector(selector: bytes) -> str: ...
