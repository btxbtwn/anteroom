# Allow only application source and deployment files into hosted builds.
*
!CHANGELOG.md
!anteroom/
anteroom/*
!anteroom/pyproject.toml
!anteroom/uv.lock
!anteroom/VERSION
!anteroom/server/
anteroom/server/*
!anteroom/server/anteroom/
!anteroom/server/anteroom/**
!deploy/
!deploy/fly/
!deploy/fly/**
# Public cloud UI source and build metadata (never local data or settings).
!anteroom/package.json
!anteroom/package-lock.json
!anteroom/cloud.html
!anteroom/index.html
!anteroom/vite.config.ts
!anteroom/tsconfig.json
!anteroom/src/
!anteroom/src/**
# Public pages, the browser tab icon, and the startup script loaded before the bundle.
!anteroom/public/
anteroom/public/*
!anteroom/public/favicon.png
!anteroom/public/privacy.html
!anteroom/public/terms.html
!anteroom/public/robots.txt
!anteroom/public/assets/
anteroom/public/assets/*
!anteroom/public/assets/theme-boot.js
# The startup screen shows the app icon.
!anteroom/desktop/
anteroom/desktop/*
!anteroom/desktop/AppIcon.png
# Validation reads which General categories have subcategories from the bundled tree seed.
!anteroom/data/
anteroom/data/*
!anteroom/data/category-trees-seed.json.gz
# Hosted generation and native forms use the same canonical public rules.
!skills/
skills/*
!skills/list-this/
skills/list-this/*
!skills/list-this/SKILL.md
!skills/list-this/references/
skills/list-this/references/*
!skills/list-this/references/*.md
!skills/list-this/references/*.json
# Measurement reading loads its skill's script and references.
!skills/measure-this/
!skills/measure-this/**
# The site compares Chrome's Anteroom Bridge with this version, and cloud
# marketplace execution runs the Poshmark native handlers from background/.
!anteroom-extension/
anteroom-extension/*
!anteroom-extension/manifest.json
!anteroom-extension/background/
!anteroom-extension/background/**
# Keep private/runtime files excluded after every source allow rule.
**/node_modules/
**/__pycache__/
**/*.pyc
**/.env*
**/*.db*
**/*.key
**/*.pem
