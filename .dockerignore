# Allow only application source and deployment files into hosted builds.
*
!CHANGELOG.md
!vendoo-studio/
vendoo-studio/*
!vendoo-studio/pyproject.toml
!vendoo-studio/uv.lock
!vendoo-studio/VERSION
!vendoo-studio/server/
vendoo-studio/server/*
!vendoo-studio/server/vendoo_studio/
!vendoo-studio/server/vendoo_studio/**
!deploy/
!deploy/fly/
!deploy/fly/**
# Public cloud UI source and build metadata (never local data or settings).
!vendoo-studio/package.json
!vendoo-studio/package-lock.json
!vendoo-studio/cloud.html
!vendoo-studio/index.html
!vendoo-studio/vite.config.ts
!vendoo-studio/tsconfig.json
!vendoo-studio/src/
!vendoo-studio/src/**
# The browser tab icon the hosted server serves at /favicon.png.
!vendoo-studio/public/
vendoo-studio/public/*
!vendoo-studio/public/favicon.png
!vendoo-studio/public/privacy.html
# The startup screen shows the app icon.
!vendoo-studio/desktop/
vendoo-studio/desktop/*
!vendoo-studio/desktop/AppIcon.png
# Hosted generation and native forms use the same canonical public rules.
!skills/
skills/*
!skills/list-this/
skills/list-this/*
!skills/list-this/SKILL.md
!skills/list-this/references/
skills/list-this/references/*
!skills/list-this/references/*.md
!skills/list-this/references/*.json
# Measurement reading and Box Scout load their skill's script and references.
!skills/measure-this/
!skills/measure-this/**
!skills/box-scout/
!skills/box-scout/**
# The site compares Chrome's Anteroom Bridge with this version.
!vendoo-extension/
vendoo-extension/*
!vendoo-extension/manifest.json
# Keep private/runtime files excluded after every source allow rule.
**/__pycache__/
**/*.pyc
**/.env*
**/*.db*
**/*.key
**/*.pem
