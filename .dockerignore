# Allow only application source and deployment files into hosted builds.
*
!CHANGELOG.md
!anteroom/
anteroom/*
!anteroom/pyproject.toml
!anteroom/uv.lock
!anteroom/VERSION
!anteroom/server/
anteroom/server/*
!anteroom/server/anteroom/
!anteroom/server/anteroom/**
!deploy/
!deploy/fly/
!deploy/fly/**
# Public cloud UI source and build metadata (never local data or settings).
!anteroom/package.json
!anteroom/package-lock.json
!anteroom/cloud.html
!anteroom/index.html
!anteroom/vite.config.ts
!anteroom/tsconfig.json
!anteroom/src/
!anteroom/src/**
# The browser tab icon the hosted server serves at /favicon.png.
!anteroom/public/
anteroom/public/*
!anteroom/public/favicon.png
!anteroom/public/privacy.html
!anteroom/public/terms.html
# The startup screen shows the app icon.
!anteroom/desktop/
anteroom/desktop/*
!anteroom/desktop/AppIcon.png
# Hosted generation and native forms use the same canonical public rules.
!skills/
skills/*
!skills/list-this/
skills/list-this/*
!skills/list-this/SKILL.md
!skills/list-this/references/
skills/list-this/references/*
!skills/list-this/references/*.md
!skills/list-this/references/*.json
# Measurement reading and Box Scout load their skill's script and references.
!skills/measure-this/
!skills/measure-this/**
!skills/box-scout/
!skills/box-scout/**
# The site compares Chrome's Anteroom Bridge with this version.
!anteroom-extension/
anteroom-extension/*
!anteroom-extension/manifest.json
# Keep private/runtime files excluded after every source allow rule.
**/__pycache__/
**/*.pyc
**/.env*
**/*.db*
**/*.key
**/*.pem
