{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "INBOX", "class_name": "Inbox" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Inbox"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] }
  ],
  // Device registration: 5 per minute per IP.
  "ratelimits": [
    { "name": "REGISTRATION_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    // "production" or "sandbox".
    "EBAY_ENV": "production",
    // The eBay RuName whose accept and decline URLs are /oauth/ebay/callback.
    "EBAY_RUNAME": "Cristian_Caniza-Cristian-Antero-dqronlnu"
  },
  "observability": { "enabled": true }
  // Secrets (set with `wrangler secret put`, never committed):
  //   EBAY_VERIFICATION_TOKEN 32-80 chars, also in eBay's portal
  //   EBAY_CLIENT_ID          production keyset App ID
  //   EBAY_CLIENT_SECRET      production keyset Cert ID
  //   ETSY_KEYSTRING          Etsy app keystring (public, but kept out of the repo)
  //   ETSY_SHARED_SECRET      Etsy app shared secret
  //   ETSY_WEBHOOK_SECRET     whsec_... from Etsy's webhook portal
}
