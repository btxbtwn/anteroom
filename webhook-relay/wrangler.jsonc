{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "INBOX", "class_name": "Inbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Inbox"] }],
  "vars": {
    // "production" or "sandbox": which eBay API issues the signing keys.
    "EBAY_ENV": "production"
  },
  "observability": { "enabled": true }
  // Secrets (set with `wrangler secret put`, never committed):
  //   STUDIO_TOKEN            bearer token Studio uses to pull events
  //   EBAY_VERIFICATION_TOKEN 32-80 chars, pasted into eBay's portal too
  //   EBAY_CLIENT_ID          production keyset App ID
  //   EBAY_CLIENT_SECRET      production keyset Cert ID
  //   ETSY_WEBHOOK_SECRET     whsec_... from Etsy's webhook portal
}
