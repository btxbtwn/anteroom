{
  "manifest_version": 3,
  "name": "Anteroom Bridge",
  "version": "0.2.37",
  "minimum_chrome_version": "116",
  "description": "Connect Anteroom to automate marketplace listing drafts",
  "permissions": [
    "alarms",
    "storage",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "tabs",
    "debugger",
    "system.display"
  ],
  "host_permissions": [
    "https://app.vendoo.co/*",
    "https://web.vendoo.co/*",
    "https://api.web.vendoo.co/*",
    "https://www.ebay.com/*",
    "https://poshmark.com/*",
    "https://www.mercari.com/*",
    "https://www.depop.com/*",
    "https://webapi.depop.com/*",
    "https://api.depop.com/*",
    "https://*.s3.amazonaws.com/*",
    "https://*.s3-accelerate.amazonaws.com/*",
    "https://www.etsy.com/*",
    "https://sellwild.com/*",
    "https://www.vinted.com/*",
    "https://vinted.com/*",
    "https://api.www.vinted.com/*",
    "http://127.0.0.1:4318/*",
    "ws://127.0.0.1:4318/*",
    "https://us.vendoo.co/*",
    "https://us-central1-vendoo-prod-7948f.cloudfunctions.net/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://storage.googleapis.com/*",
    "https://firebasestorage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.vendoo.co/*",
        "https://web.vendoo.co/*"
      ],
      "js": [
        "content-script-version.js",
        "content-scripts/update-all-buttons.js",
        "content-scripts/marketplace-colors.js",
        "content-scripts/vendoo.js"
      ]
    },
    {
      "matches": [
        "https://www.ebay.com/*"
      ],
      "js": [
        "content-scripts/ebay.js"
      ]
    },
    {
      "matches": [
        "https://poshmark.com/*"
      ],
      "js": [
        "content-scripts/poshmark.js"
      ]
    },
    {
      "matches": [
        "https://www.mercari.com/*"
      ],
      "js": [
        "content-scripts/mercari.js"
      ]
    },
    {
      "matches": [
        "https://www.depop.com/*"
      ],
      "js": [
        "content-scripts/depop.js"
      ]
    },
    {
      "matches": [
        "https://www.vinted.com/*",
        "https://vinted.com/*"
      ],
      "js": [
        "content-scripts/vinted.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
