{
  "manifest_version": 3,
  "name": "Anteroom Bridge",
  "version": "0.2.69",
  "minimum_chrome_version": "120",
  "description": "Lets Anteroom publish, update and delist your marketplace listings, save drafts, share, send offers, and read sales and likes.",
  "permissions": [
    "alarms",
    "storage",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "tabs",
    "debugger",
    "system.display"
  ],
  "host_permissions": [
    "https://web.vendoo.co/*",
    "https://app.vendoo.co/*",
    "https://us.vendoo.co/*",
    "https://us-central1-vendoo-prod-7948f.cloudfunctions.net/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://storage.googleapis.com/*",
    "https://firebasestorage.googleapis.com/*",
    "https://www.ebay.com/*",
    "https://poshmark.com/*",
    "https://www.mercari.com/*",
    "https://www.depop.com/*",
    "https://webapi.depop.com/*",
    "https://*.s3.amazonaws.com/*",
    "https://*.s3-accelerate.amazonaws.com/*",
    "https://www.etsy.com/*",
    "http://127.0.0.1:4318/*",
    "ws://127.0.0.1:4318/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://myanteroom.com/*"
      ],
      "js": [
        "cloud-marketplace-protocol.js",
        "content-scripts/cloud-connection.js"
      ],
      "all_frames": false,
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
